# Shared local configuration. Copy to .env; never commit .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# PUBLISHABLE_KEY is also accepted; both key aliases must agree when set.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Two confirmed, disposable accounts for live auth and ownership verification.
# These are never included in the browser bundle. Keep values local.
SUPABASE_TEST_EMAIL_A=
SUPABASE_TEST_PASSWORD_A=
SUPABASE_TEST_EMAIL_B=
SUPABASE_TEST_PASSWORD_B=
