HOST=127.0.0.1
PORT=3001
# Set both, or use the shared root public pair, to enable authentication and storage.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY is also accepted. Without a server pair, use the root public pair.
# Use a publishable key (or legacy anon key), never a secret/service-role key.

# Server-only Geoapify Free-project key. Never use a VITE variable.
GEOAPIFY_API_KEY=
# Daily HTTP-request allowance, including geocoding, pages and retries; hard max 1000.
GEOAPIFY_DAILY_LIMIT=100

# Optional server-only discovery credential; only an active free plan is accepted.
SERPAPI_API_KEY=
SERPAPI_MONTHLY_LIMIT=50
# Server-only comma-separated Supabase Auth UUIDs allowed to consume providers.
# Empty means denied. Never set on Vercel or prefix with VITE_.
PROVIDER_ALLOWED_USER_IDS=
# Configurable countries (ISO 3166-1 alpha-2); defaults match SPEC.md.
DISCOVERY_MARKETS=US,GB,CA,AU
# Optional JSON list: [{"id":"dentists","label":"Dentists","tags":[["amenity","dentist"]]}]
# Leave empty to use all nine starter niches.
DISCOVERY_NICHES_JSON=
# Historical OSM adapter is inactive; Nominatim/Overpass settings are unused.

# Explicit contact fallback only. Never prefix this secret with VITE_.
HUNTER_API_KEY=
# Set true only AFTER verifying a real Free-plan credential. A key alone stays disabled.
HUNTER_FREE_PLAN_VERIFIED=false
# Conservative attempt cap, 1–50; provider free credits are checked independently.
HUNTER_MONTHLY_LIMIT=10
# Production quota RPCs only. Never use this key for lead/settings clients or VITE_.
# Supabase secret key or legacy service_role key; private, server-side only.
SUPABASE_QUOTA_SERVICE_KEY=
# Optional absolute local-development usage directory. Production never uses files.
# USAGE_DIRECTORY=
